# Copy to .env and fill in for local development.
# Never commit .env — see SECURITY notes in README.md.

DATABASE_URL="postgresql://sv_recruiting@localhost:5432/sv_recruiting?schema=public"

# JWT signing secret — generate a real random value per environment.
JWT_ACCESS_SECRET="dev-only-change-me-access"
JWT_REFRESH_SECRET="dev-only-change-me-refresh"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

PORT=4000

# Local disk CV storage root (swap for real object storage in production —
# see src/lib/storage.ts for the interface this must satisfy).
CV_STORAGE_ROOT="./storage/files"

# Signed CV-download URL secret + expiry (seconds).
FILE_URL_SECRET="dev-only-change-me-file-urls"
FILE_URL_TTL_SECONDS=300

# Webhook signing secret for the test-provider integration boundary (§11).
# No real provider is configured yet — see MIGRATION.md / final report §12.
TEST_PROVIDER_WEBHOOK_SECRET="dev-only-change-me-webhook"

# Real SMTP mailer for "INVIA LINK TEST" (see src/lib/mailer.ts). Placeholders
# only — NEVER put the real mailbox password in this file (it's the
# committed example; the real value goes in .env, which is gitignored).
# Leaving SMTP_HOST/SMTP_USER/SMTP_PASSWORD/MAIL_FROM unset disables real
# sending (send-test then fails clearly with a 502 instead of pretending to
# have sent anything — see shortlist/routes.ts POST /:id/send-test).
SMTP_HOST="srv.hdedi-xlogic4000.org"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="info@skill-vision.it"
SMTP_PASSWORD="REPLACE_WITH_REAL_MAILBOX_PASSWORD"
MAIL_FROM="info@skill-vision.it"
MAIL_FROM_NAME="Skill Vision"
