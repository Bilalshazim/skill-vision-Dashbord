VITE_API_BASE_URL=http://localhost:4000/api/v1

# Password dell'account backend "operatore" (RECRUITER), usata dal ponte di
# autenticazione (src/lib/api/authBridge.ts) per gli utenti del guscio
# "operatore" e per quelli senza una corrispondenza. Senza valore quel login
# fallisce e Assessment mostra "Impossibile verificare i moduli attivi".
# ATTENZIONE: con il prefisso VITE_ Vite la scrive nel bundle servito al
# browser, quindi non è un segreto. Va eliminata con il rifacimento del login
# (Fase 4). Il valore reale sta solo nelle variabili del servizio su Railway.
VITE_OPERATORE_BRIDGE_PASSWORD=

# Catalogo dei componenti su /dev/components anche nella build (non solo con
# `npm run dev`). Si accende SOLO nell'anteprima interna su Railway, con il
# valore esatto "true". È una variabile di compilazione: su Railway va messa
# fra le variabili del servizio frontend e richiede un nuovo deploy. Da
# spegnere (togliere) prima che in produzione entri un cliente reale.
VITE_ENABLE_COMPONENT_CATALOG=

# Versione demo (CLAUDE.md cap. 7, "Reset demo"): con "true" la barra laterale
# di Assessment mostra "Reset demo", che cancella e rigenera i dati del
# modulo. Solo sul servizio che fa da demo; in `npm run dev` vale sempre.
# Variabile di compilazione: su Railway richiede un nuovo deploy.
VITE_DEMO_MODE=

# Fase 8 — come si entra. Vuoto o `legacy`: il login del guscio (index.html),
# come oggi. `backend`: login React su /login, refresh token in cookie
# httpOnly, permessi dal ruolo. Con `backend`, VITE_API_BASE_URL va messo a
# `/api/v1` (stessa origine) e il server del frontend ha bisogno di
# BACKEND_INTERNAL_URL (variabile del servizio, non VITE_: vedi
# scripts/serve-combined.mjs). Da provare su un ambiente separato.
VITE_AUTH_MODE=
